		_elements = {}, _conns = {}, _userScale = opts.Scale or 1, _dim = opts.Dim or 0.55, _bokeh = opts.Bokeh ~= false,
	}
	local name = opts.Name or "Ouroboros"
	local version = opts.Version or "v0.1"
	local baseW, baseH = 680, 440
	if opts.Size then
		baseW, baseH = opts.Size.X.Offset, opts.Size.Y.Offset
	end

	local function keep(c)
		table.insert(Window._conns, c)
		return c
	end

	local gui = NewScreenGui("OuroborosUI", 100)
	Window.Gui = gui

	-- dim + bokeh ------------------------------------------------------
	local dim = New("Frame", { Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0, Active = false })
	local bokehLayer = New("Frame", { Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1 })

	local particles = {}
	local rng = Random.new()
	for _ = 1, opts.Particles or (IS_MOBILE and 14 or 28) do
		local size = rng:NextInteger(10, 46)
		local dot = New("Frame", {
			Parent = bokehLayer, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size),
			Position = UDim2.fromScale(rng:NextNumber(), rng:NextNumber()), BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1, BorderSizePixel = 0,
		}, { Corner(size), Stroke(Color3.new(1, 1, 1), 0.88, 1) })
		table.insert(particles, {
			obj = dot, x = rng:NextNumber(), y = rng:NextNumber(),
			vx = rng:NextNumber(-0.012, 0.012), vy = rng:NextNumber(-0.02, -0.004),
			base = rng:NextNumber(0.9, 0.97), phase = rng:NextNumber(0, 6.28),
		})
	end
	local clock = 0
	keep(RunService.RenderStepped:Connect(function(dt)
		if not Window.Visible or not Window._bokeh then
			return
		end
		clock += dt
		for _, p in ipairs(particles) do
			p.x += p.vx * dt
			p.y += p.vy * dt
			if p.y < -0.1 then
				p.y = 1.1
				p.x = rng:NextNumber()
			end
			if p.x < -0.1 then
				p.x = 1.1
			elseif p.x > 1.1 then
				p.x = -0.1
			end
			p.obj.Position = UDim2.fromScale(p.x, p.y)
			p.obj.BackgroundTransparency = p.base + math.sin(clock + p.phase) * 0.03
		end
	end))

	-- dynamic island ---------------------------------------------------
	local island = New("Frame", {
		Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(150, 34), BackgroundColor3 = Theme.Backdrop, ZIndex = 50, ClipsDescendants = true,
	}, { Corner(17), Stroke(Theme.Stroke, 0.3) })

	New("Frame", { Parent = island, Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Theme.Element, ZIndex = 51 }, { Corner(12) })
	Acc(Label({ Parent = island, Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(24, 24), Text = "◉",
		TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 52 }), "TextColor3")
	local islandName = Label({ Parent = island, Position = UDim2.fromOffset(38, 0), Size = UDim2.fromOffset(80, 34),
		Text = name, Font = Theme.FontBold, TextSize = 12, ZIndex = 52 })

	local islandBars = New("Frame", { Parent = island, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -40, 0.5, 0), Size = UDim2.fromOffset(18, 14), BackgroundTransparency = 1,
		Visible = false, ZIndex = 52 })
	for i = 1, 3 do
		local b = New("Frame", { Parent = islandBars, Position = UDim2.new(0, (i - 1) * 6, 1, 0),
			AnchorPoint = Vector2.new(0, 1), Size = UDim2.fromOffset(3, 5 + i * 3), BorderSizePixel = 0, ZIndex = 52 },
			{ Corner(1) })
		if i == 3 then
			b.BackgroundColor3 = Theme.Warn
		else
			Acc(b, "BackgroundColor3")
		end
	end
	local islandFps = Label({ Parent = island, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0),
		Size = UDim2.fromOffset(26, 34), Text = "", TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12,
		Font = Theme.FontBold, ZIndex = 52, Visible = false })

	local fps = 60
	local acc, frames = 0, 0
	keep(RunService.RenderStepped:Connect(function(dt)
		acc += dt
		frames += 1
		if acc >= 0.5 then
			fps = math.floor(frames / acc + 0.5)
			acc, frames = 0, 0
			islandFps.Text = tostring(fps)
		end
	end))

	local function setIslandExpanded(on)
		islandBars.Visible = on
		islandFps.Visible = on
		Tween(island, { Size = UDim2.fromOffset(on and 215 or 150, 34) }, 0.35, Enum.EasingStyle.Back)
	end
	local islandBtn = New("TextButton", { Parent = island, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = "", ZIndex = 60 })

	function Window:SetIslandText(text)
		islandName.Text = text
	end

	-- main frame -------------------------------------------------------
	local main = New("Frame", {
		Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(baseW, baseH), BackgroundColor3 = Theme.Main, ClipsDescendants = true, ZIndex = 10,
	}, { Corner(14), Stroke(Theme.Stroke, 0.2) })
	Window.Main = main
	local uiScale = New("UIScale", { Parent = main, Scale = 1 })

	-- notifications container (scaled the same way)
	local notifHolder = New("Frame", {
		Parent = gui, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 56),
		Size = UDim2.fromOffset(290, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 80,
	}, { List(8) })
	notifHolder.UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	local notifScale = New("UIScale", { Parent = notifHolder, Scale = 1 })
