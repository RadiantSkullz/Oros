					Size = UDim2.fromOffset(14, 14), Text = "⌄", TextColor3 = Theme.Muted, TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Center })
				local list = New("ScrollingFrame", { Parent = wrap, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.CardHeader,
					Visible = false, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Stroke, BorderSizePixel = 0,
					CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y },
					{ Corner(8), Stroke(Theme.Stroke, 0.3), List(2), Pad(4, 4) })
				local items = {}
				local obj = {}

				local function getMulti()
					local out = {}
					for _, o in ipairs(options) do
						if selected[o] then
							table.insert(out, o)
						end
					end
					return out
				end
				local function refresh()
					for opt, it in pairs(items) do
						local on = multi and selected[opt] or (not multi and single == opt)
						it.mark.Visible = on
						it.label.TextColor3 = on and Theme.Accent or Theme.Text
					end
					if multi then
						local m = getMulti()
						txt.Text = #m == 0 and "None" or table.concat(m, ", ")
					else
						txt.Text = single ~= nil and tostring(single) or "None"
					end
				end
				local function fire()
					if o2.Callback then
						task.spawn(o2.Callback, multi and getMulti() or single)
					end
				end
				local function build()
					for _, c2 in ipairs(list:GetChildren()) do
						if c2:IsA("TextButton") then
							c2:Destroy()
						end
					end
					items = {}
					for _, opt in ipairs(options) do
						local b = New("TextButton", { Parent = list, Size = UDim2.new(1, -4, 0, 28), BackgroundColor3 = Theme.Element,
							BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, { Corner(5) })
						local l = Label({ Parent = b, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -30, 1, 0), Text = tostring(opt),
							TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd })
						local mk = Acc(Label({ Parent = b, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
							Size = UDim2.fromOffset(14, 14), Text = "✓", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center,
							Visible = false }), "TextColor3")
						items[opt] = { label = l, mark = mk }
						b.MouseEnter:Connect(function() Tween(b, { BackgroundTransparency = 0 }, 0.1) end)
						b.MouseLeave:Connect(function() Tween(b, { BackgroundTransparency = 1 }, 0.1) end)
						b.MouseButton1Click:Connect(function()
							if multi then
								selected[opt] = not selected[opt] or nil
							else
								single = opt
								list.Visible = false
								Tween(arrow, { Rotation = 0 }, 0.15)
							end
							refresh()
							fire()
						end)
					end
					list.Size = UDim2.new(1, 0, 0, math.min(#options, 6) * 30 + 8)
					refresh()
				end
				build()
				btn.MouseButton1Click:Connect(function()
					list.Visible = not list.Visible
					Tween(arrow, { Rotation = list.Visible and 180 or 0 }, 0.15)
				end)
				function obj:Get() return multi and getMulti() or single end
				function obj:Set(v)
					if multi then
						selected = {}
						for _, x in ipairs(v or {}) do selected[x] = true end
					else
						single = v
					end
					refresh()
					fire()
				end
				function obj:Refresh(newOptions, keepSelection)
					options = newOptions
					if not keepSelection then
						selected = {}
						single = (not multi) and options[1] or nil
					end
					build()
				end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, wrap, o2.Desc)
				return obj
			end

			-- text input --------------------------------------------------
			function card:AddInput(o2)
				local row = MakeRow(self.Body, o2.Name, o2.Desc, 150)
				local box = New("TextBox", { Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(140, 30), BackgroundColor3 = Theme.Element, Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.Text, PlaceholderText = o2.Placeholder or "Type here...", PlaceholderColor3 = Theme.Muted,
					Text = tostring(o2.Default or ""), ClearTextOnFocus = false, TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left }, { Corner(7), Stroke(Theme.Stroke, 0.5), Pad(10, 0) })
				local obj = {}
				local function out()
					if o2.Numeric then
						return tonumber(box.Text)
					end
					return box.Text
				end
				if o2.Numeric then
					box:GetPropertyChangedSignal("Text"):Connect(function()
						local clean = box.Text:gsub("[^%d%.%-]", "")
						if clean ~= box.Text then
							box.Text = clean
						end
					end)
				end
				box.FocusLost:Connect(function(enter)
					if o2.Callback and (enter or not o2.EnterOnly) then
						task.spawn(o2.Callback, out())
					end
				end)
				function obj:Get() return out() end
				function obj:Set(v)
					box.Text = tostring(v or "")
					if o2.Callback then
						task.spawn(o2.Callback, out())
					end
				end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, row, o2.Desc)
				return obj
			end

			-- keybind -----------------------------------------------------
			function card:AddKeybind(o2)
				local key = o2.Default or Enum.KeyCode.Unknown
				local listening = false
				local row = MakeRow(self.Body, o2.Name, o2.Desc, 96)
				local btn = New("TextButton", { Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(86, 28), BackgroundColor3 = Theme.Element, Font = Theme.FontBold, TextSize = 11,
					TextColor3 = Theme.Text, Text = "", AutoButtonColor = false }, { Corner(7), Stroke(Theme.Stroke, 0.5) })
				local function paint()
					btn.Text = listening and "..." or (key == Enum.KeyCode.Unknown and "None" or key.Name)
					btn.TextColor3 = listening and Theme.Accent or Theme.Text
				end
				paint()
				btn.MouseButton1Click:Connect(function()
					listening = true
					paint()
				end)
				local obj = {}
				keep(UserInputService.InputBegan:Connect(function(input, gp)
					if listening then
						if input.UserInputType == Enum.UserInputType.Keyboard then
							listening = false
							key = input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode
							paint()
							if o2.ChangedCallback then
								task.spawn(o2.ChangedCallback, key)
							end
						end
						return
					end
					if not gp and key ~= Enum.KeyCode.Unknown and input.KeyCode == key and o2.Callback then
						task.spawn(o2.Callback, key)
					end
				end))
				function obj:Get() return key end
				function obj:Set(k)
					key = k or Enum.KeyCode.Unknown
					paint()
					if o2.ChangedCallback then
						task.spawn(o2.ChangedCallback, key)
					end
				end
				function obj:IsDown() return key ~= Enum.KeyCode.Unknown and UserInputService:IsKeyDown(key) end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, row, o2.Desc)
				return obj
			end

