	-- search filtering: hides non-matching rows, and cards left with nothing in them
	local function applySearch()
		local q = searchBox.Text:lower()
		local tab = Window.CurrentTab
		if not tab then
			return
		end
		local hasMatch = {}
		for _, e in ipairs(Window._elements) do
			if e.tab == tab and e.frame.Parent then
				local titleHit = q ~= "" and e.card and e.card._title:find(q, 1, true) ~= nil
				local match = q == "" or titleHit or e.search:find(q, 1, true) ~= nil
				e.frame.Visible = match
				if match and e.card then
					hasMatch[e.card] = true
				end
			end
		end
		for _, card in ipairs(tab._cards or {}) do
			if card._frame.Parent then
				card._frame.Visible = q == "" or hasMatch[card] == true
			end
		end
	end
