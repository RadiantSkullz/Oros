			function card:AddSlider(o2)
				local min, max, dec = o2.Min or 0, o2.Max or 100, o2.Decimals or 0
				local value = math.clamp(o2.Default or min, min, max)
				local wrap = VBox(self.Body, 4)
				local top = MakeRow(wrap, o2.Name, o2.Desc, 70)
				local box = New("TextBox", { Parent = top, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0, 14),
					Size = UDim2.fromOffset(60, 26), BackgroundColor3 = Theme.Element, Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.Text, Text = "", ClearTextOnFocus = false }, { Corner(6), Stroke(Theme.Stroke, 0.5) })
				local hit = New("Frame", { Parent = wrap, Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1 })
				local back = New("Frame", { Parent = hit, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = Theme.Element, BorderSizePixel = 0 }, { Corner(3) })
				local fill = Acc(New("Frame", { Parent = back, Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, { Corner(3) }),
					"BackgroundColor3")
				Acc(New("Frame", { Parent = fill, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(14, 14) }, { Corner(7) }), "BackgroundColor3")
				local suffix = o2.Suffix or ""
				local obj = {}
				local function set(v, silent)
					if o2.Step then
						v = min + math.floor((v - min) / o2.Step + 0.5) * o2.Step
					end
					v = math.clamp(Round(v, dec), min, max)
					value = v
					box.Text = tostring(v) .. suffix
					fill.Size = UDim2.new((max == min) and 0 or (v - min) / (max - min), 0, 1, 0)
					if not silent and o2.Callback then
						task.spawn(o2.Callback, v)
					end
				end
				local function fromX(x)
					local rel = math.clamp((x - back.AbsolutePosition.X) / math.max(back.AbsoluteSize.X, 1), 0, 1)
					set(min + (max - min) * rel)
				end
				TrackDrag(hit, keep, function(input)
					page.ScrollingEnabled = false
					fromX(input.Position.X)
				end, function(pos)
					fromX(pos.X)
				end, function()
					page.ScrollingEnabled = true
				end)
				box.FocusLost:Connect(function()
					local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
					set(n or value)
				end)
				set(value, true)
				function obj:Set(v) set(v) end
				function obj:Get() return value end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, wrap, o2.Desc)
				return obj
			end

