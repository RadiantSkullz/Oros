	-- visibility -------------------------------------------------------
	function Window:SetVisible(v)
		self.Visible = v
		if v then
			main.Visible = true
			main.Size = UDim2.fromOffset(baseW - 20, baseH - 16)
			Tween(main, { Size = UDim2.fromOffset(baseW, baseH) }, 0.35, Enum.EasingStyle.Back)
			Tween(dim, { BackgroundTransparency = self._dim }, 0.4)
			bokehLayer.Visible = self._bokeh
			setIslandExpanded(false)
		else
			Tween(main, { Size = UDim2.fromOffset(baseW - 40, baseH - 30) }, 0.2)
			Tween(dim, { BackgroundTransparency = 1 }, 0.3)
			task.delay(0.2, function()
				if not self.Visible then
					main.Visible = false
					bokehLayer.Visible = false
				end
			end)
			setIslandExpanded(true)
		end
		if self.OnToggle then
			task.spawn(self.OnToggle, v)
		end
	end
	function Window:Toggle()
		self:SetVisible(not self.Visible)
	end
	function Window:SetBokeh(on)
		self._bokeh = on
		bokehLayer.Visible = on and self.Visible
	end
	function Window:SetDim(alpha)
		self._dim = math.clamp(alpha, 0, 1)
		if self.Visible then
			Tween(dim, { BackgroundTransparency = self._dim }, 0.2)
		end
	end
	function Window:SetAccent(c)
		Library:SetAccent(c)
	end
	function Window:Destroy()
		for _, c in ipairs(self._conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
		gui:Destroy()
	end

