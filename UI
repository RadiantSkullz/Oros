local function MakeIcon(p)
	local size = p.Size or 16
	local z = p.ZIndex or 1
	local holder = New("Frame", {
		Parent = p.Parent, Size = UDim2.fromOffset(size, size), Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.new(), BackgroundTransparency = 1, ZIndex = z,
	})
	local img = New("ImageLabel", {
		Parent = holder, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		ImageColor3 = p.Color or Theme.Text, Visible = false, ZIndex = z,
	})
	local txt = Label({
		Parent = holder, Size = UDim2.fromScale(1, 1), Font = Theme.FontBold, TextSize = math.max(8, size - 3),
		TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = p.Color or Theme.Text, Visible = false, ZIndex = z,
	})
	local icon = { Frame = holder, Image = img, Glyph = txt }
	function icon:SetIcon(name)
		local a = GetIconAsset(name)
		if a then
			img.Image = a.Url
			img.ImageRectSize = a.ImageRectSize
			img.ImageRectOffset = a.ImageRectOffset
			img.Visible, txt.Visible = true, false
		else
			txt.Text = FALLBACK[name] or "•"
			img.Visible, txt.Visible = false, true
		end
	end
	function icon:SetColor(c)
		img.ImageColor3 = c
		txt.TextColor3 = c
	end
	function icon:TweenColor(c, t)
		Tween(img, { ImageColor3 = c }, t or 0.2)
		Tween(txt, { TextColor3 = c }, t or 0.2)
	end
	icon:SetIcon(p.Name)
	if p.Accent then
		OnAccent(function(c)
			icon:SetColor(c)
		end)
	end
	return icon
end

-- logo: "beyond the horizon" -- a sun rising over a horizon line, built from plain UI shapes ------------

local function MakeLogo(parent, size, opts)
	opts = opts or {}
	local s = size
	local z = opts.ZIndex or 1
	local bg = opts.Background or Theme.Element
	local holder = New("Frame", {
		Parent = parent, Size = UDim2.fromOffset(s, s), Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.new(), BackgroundColor3 = bg, ClipsDescendants = true, ZIndex = z,
	}, { Corner(s) })

	local ring = Stroke(Theme.Accent, 0.55, 1)
	ring.Parent = holder
	Acc(ring, "Color")

	local horizon = math.floor(s * 0.6 + 0.5)

	-- soft glow around the sun (stacked translucent discs)
	for _, g in ipairs({ { 1.05, 0.93 }, { 0.78, 0.86 } }) do
		local d = s * g[1]
		Acc(New("Frame", {
			Parent = holder, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, horizon),
			Size = UDim2.fromOffset(d, d), BackgroundTransparency = g[2], ZIndex = z + 1,
		}, { Corner(d) }), "BackgroundColor3")
	end

	-- the sun
	local sunD = s * 0.42
	local sun = Acc(New("Frame", {
		Parent = holder, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, horizon),
		Size = UDim2.fromOffset(sunD, sunD), ZIndex = z + 2,
	}, {
		Corner(sunD),
		New("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.35) }),
		}),
	}), "BackgroundColor3")

	-- ground hides the lower half of the sun
	New("Frame", {
		Parent = holder, Position = UDim2.fromOffset(0, horizon), Size = UDim2.new(1, 0, 0, s - horizon),
		BackgroundColor3 = bg, ZIndex = z + 3,
	})

	local fade = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.22, 0),
		NumberSequenceKeypoint.new(0.78, 0), NumberSequenceKeypoint.new(1, 1),
	})
	local function line(y, w, thick, transparency)
		Acc(New("Frame", {
			Parent = holder, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, y),
			Size = UDim2.new(w, 0, 0, thick), BackgroundTransparency = transparency, ZIndex = z + 4,
		}, { New("UIGradient", { Transparency = fade }) }), "BackgroundColor3")
	end
	line(horizon, 0.86, math.max(1, math.floor(s * 0.05)), 0)
	line(horizon + math.floor(s * 0.13), 0.5, 1, 0.55)
	line(horizon + math.floor(s * 0.23), 0.26, 1, 0.75)

	return holder
end

-- row builder: name (+ optional description) on the left, control space on the right
local function MakeRow(parent, name, desc, controlW)
	local row = New("Frame", {
		Parent = parent, Size = UDim2.new(1, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	})
	local text = New("Frame", {
		Parent = row, Size = UDim2.new(1, -((controlW or 0) + 10), 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, { List(1) })
	local nameLabel = Label({
		Parent = text, Size = UDim2.new(1, 0, 0, desc and 18 or 28), AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true, Text = name or "",
	})
	local descLabel
	if desc then
		descLabel = Label({
			Parent = text, Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
			Text = desc, TextColor3 = Theme.Muted, TextSize = 11, TextYAlignment = Enum.TextYAlignment.Top,
		})
	end
	return row, nameLabel, descLabel
end

local function VBox(parent, gap)
	return New("Frame", {
