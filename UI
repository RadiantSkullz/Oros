	-- tabs -------------------------------------------------------------
	function Window:SelectTab(tab)
		if type(tab) == "string" then
			for _, t in ipairs(self.Tabs) do
				if t.Name == tab then
					tab = t
					break
				end
			end
		end
		if type(tab) ~= "table" or self.CurrentTab == tab then
			return
		end
		if self.CurrentTab then
			local old = self.CurrentTab
			old.Page.Visible = false
			Tween(old.Button, { BackgroundTransparency = 1 }, 0.2)
			Tween(old.ButtonLabel, { TextColor3 = Theme.Muted }, 0.2)
			old.ButtonIcon.TextColor3 = Theme.Muted
		end
		self.CurrentTab = tab
		tab.Page.Visible = true
		Tween(tab.Button, { BackgroundTransparency = 0 }, 0.2)
		Tween(tab.ButtonLabel, { TextColor3 = Theme.Text }, 0.2)
		tab.ButtonIcon.TextColor3 = Theme.Accent
		headTitle.Text = tab.Name
		headIcon.Text = tab.Icon
		searchBox.Text = ""
		applySearch()
	end

	-- config -------------------------------------------------------------
	local function fsReady()
		return type(writefile) == "function" and type(readfile) == "function"
	end
	local function encode(v)
		if typeof(v) == "Color3" then
			return { __t = "Color3", r = v.R, g = v.G, b = v.B }
		elseif typeof(v) == "EnumItem" then
			return { __t = "KeyCode", n = v.Name }
		end
		return v
	end
	local function decode(v)
		if type(v) == "table" and v.__t == "Color3" then
			return Color3.new(v.r, v.g, v.b)
		elseif type(v) == "table" and v.__t == "KeyCode" then
			return Enum.KeyCode[v.n] or Enum.KeyCode.Unknown
		end
		return v
	end
	local function cfgPath(n)
		return Window.ConfigFolder .. "/" .. n .. ".json"
	end

	function Window:SaveConfig(cfg)
		if not fsReady() then
			return false, "executor has no file access"
		end
		local data = {}
		for flag, o in pairs(self.Flags) do
			data[flag] = encode(o.Get())
		end
		pcall(function()
			if not isfolder(self.ConfigFolder) then
				makefolder(self.ConfigFolder)
			end
		end)
		local ok, err = pcall(writefile, cfgPath(cfg), HttpService:JSONEncode(data))
		return ok, err
	end
	function Window:LoadConfig(cfg)
		if not fsReady() then
			return false, "executor has no file access"
		end
		local ok, raw = pcall(readfile, cfgPath(cfg))
		if not ok then
			return false, "config not found"
		end
		local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok2 then
			return false, "config is corrupted"
		end
		for flag, v in pairs(data) do
			local o = self.Flags[flag]
			if o then
				pcall(o.Set, decode(v))
			end
		end
		return true
	end
	function Window:ListConfigs()
		local out = {}
		if type(listfiles) == "function" then
			pcall(function()
				if not isfolder(self.ConfigFolder) then
					return
				end
				for _, f in ipairs(listfiles(self.ConfigFolder)) do
					local n = tostring(f):match("([^/\\]+)%.json$")
					if n then
						table.insert(out, n)
					end
				end
			end)
		end
		return out
	end
	function Window:DeleteConfig(cfg)
		if type(delfile) == "function" then
			return pcall(delfile, cfgPath(cfg))
		end
		return false
	end

