				local wrap = VBox(self.Body, 8)
				local top = MakeRow(wrap, o2.Name, o2.Desc, 50)
				local swatch = New("TextButton", { Parent = top, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(38, 22), BackgroundColor3 = color, Text = "", AutoButtonColor = false },
					{ Corner(6), Stroke(Theme.Stroke, 0.3) })
				local panel = New("Frame", { Parent = wrap, Size = UDim2.new(1, 0, 0, 104), BackgroundTransparency = 1, Visible = false })
				local sv = New("Frame", { Parent = panel, Size = UDim2.new(1, -28, 1, 0), BackgroundColor3 = Color3.fromHSV(h, 1, 1),
					ClipsDescendants = true, BorderSizePixel = 0 }, { Corner(6) })
				New("Frame", { Parent = sv, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 },
					{ New("UIGradient", { Transparency = NumberSequence.new(0, 1) }) })
				New("Frame", { Parent = sv, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 },
					{ New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }) })
				local svCursor = New("Frame", { Parent = sv, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12),
					BackgroundTransparency = 1, ZIndex = 5 }, { Corner(6), Stroke(Color3.new(1, 1, 1), 0, 2) })
				local hue = New("Frame", { Parent = panel, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.new(0, 18, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, {
					Corner(6),
					New("UIGradient", { Rotation = 90, Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
						ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
						ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
						ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
						ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
						ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
					}) }),
				})
				local hueCursor = New("Frame", { Parent = hue, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 6, 0, 4),
					BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 5 }, { Corner(2), Stroke(Color3.new(0, 0, 0), 0.4, 1) })
				local obj = {}
				local function apply(silent)
					color = Color3.fromHSV(h, s, v)
					swatch.BackgroundColor3 = color
					sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
					svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
					hueCursor.Position = UDim2.new(0.5, 0, h, 0)
					if not silent and o2.Callback then
						task.spawn(o2.Callback, color)
					end
				end
				apply(true)
				local function svMove(pos)
					s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
					v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
					apply()
				end
				local function hueMove(pos)
					h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 0.999)
					apply()
				end
				TrackDrag(sv, keep, function(i) page.ScrollingEnabled = false; svMove(i.Position) end, svMove,
					function() page.ScrollingEnabled = true end)
				TrackDrag(hue, keep, function(i) page.ScrollingEnabled = false; hueMove(i.Position) end, hueMove,
					function() page.ScrollingEnabled = true end)
				swatch.MouseButton1Click:Connect(function()
					panel.Visible = not panel.Visible
				end)
				function obj:Get() return color end
				function obj:Set(c2)
					h, s, v = c2:ToHSV()
					apply()
				end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, wrap, o2.Desc)
				return obj
			end

			-- progress bar ------------------------------------------------
			function card:AddProgress(o2)
				local min, max = o2.Min or 0, o2.Max or 100
				local value = o2.Default or min
				local wrap = VBox(self.Body, 4)
				local top = MakeRow(wrap, o2.Name, o2.Desc, 70)
				local valLabel = Label({ Parent = top, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0, 14),
					Size = UDim2.fromOffset(60, 20), Text = "", TextColor3 = Theme.Muted, TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Right })
				local back = New("Frame", { Parent = wrap, Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0 }, { Corner(3) })
				local fill = Acc(New("Frame", { Parent = back, Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, { Corner(3) }),
					"BackgroundColor3")
				local obj = {}
				function obj:Set(v2)
					value = math.clamp(v2, min, max)
					local p = (max == min) and 0 or (value - min) / (max - min)
					valLabel.Text = math.floor(p * 100) .. "%"
					Tween(fill, { Size = UDim2.fromScale(p, 1) }, 0.25)
				end
				function obj:Get() return value end
				obj:Set(value)
				register(o2.Name, wrap, o2.Desc)
				return obj
			end

			return card
		end

