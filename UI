-- helpers ---------------------------------------------------------------

local function New(class, props, children)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			obj[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = obj
	end
	if props and props.Parent then
		obj.Parent = props.Parent
	end
	return obj
end

local function Corner(r)
	return New("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function Stroke(color, transparency, thickness)
	return New("UIStroke", {
		Color = color or Theme.Stroke,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function Pad(l, t, r, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l),
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or l),
		PaddingBottom = UDim.new(0, b or t),
	})
end

local function List(padding, dir)
	return New("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = dir or Enum.FillDirection.Vertical,
	})
end

local function Tween(obj, props, t, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function Label(props)
	local p = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}
	for k, v in pairs(props) do
		p[k] = v
	end
	return New("TextLabel", p)
end

local function Round(n, decimals)
	local m = 10 ^ (decimals or 0)
	return math.floor(n * m + 0.5) / m
end

local function ViewSize()
	local cam = workspace.CurrentCamera
	if cam and cam.ViewportSize.X > 0 then
		return cam.ViewportSize
	end
	return Vector2.new(1280, 720)
end

local function GetParent()
	local ok, ui = pcall(function()
		return gethui and gethui()
	end)
	if ok and ui then
		return ui
	end
	local ok2, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok2 and core then
		return core
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function NewScreenGui(name, order)
	local gui = New("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 100,
	})
	pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(gui)
		end
	end)
	gui.Parent = GetParent()
	return gui
end

-- generic drag tracker (mouse + touch). onMove receives the input Vector3 position
local function TrackDrag(handle, keep, onStart, onMove, onEnd)
	local active, token = false, nil
	keep(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			active, token = true, input
			if onStart then
				onStart(input)
			end
		end
	end))
	keep(UserInputService.InputChanged:Connect(function(input)
		if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input == token) then
			onMove(input.Position)
		end
	end))
	keep(UserInputService.InputEnded:Connect(function(input)
		if active and token and (input == token or (token.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			active = false
			if onEnd then
				onEnd()
			end
		end
	end))
end

-- accent recolor registry --------------------------------------------------

local accentHooks = {}
local function OnAccent(fn)
	table.insert(accentHooks, fn)
	fn(Theme.Accent)
end

local function Acc(obj, prop)
	OnAccent(function(c)
		pcall(function()
			obj[prop] = c
		end)
	end)
	return obj
end

function Library:SetAccent(color)
	Theme.Accent = color
	Theme.AccentDark = color:Lerp(Color3.new(0, 0, 0), 0.25)
	for _, fn in ipairs(accentHooks) do
		pcall(fn, color)
	end
end

-- row builder: name (+ optional description) on the left, control space on the right
local function MakeRow(parent, name, desc, controlW)
	local row = New("Frame", {
		Parent = parent, Size = UDim2.new(1, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	})
	local text = New("Frame", {
		Parent = row, Size = UDim2.new(1, -((controlW or 0) + 10), 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, { List(1) })
	local nameLabel = Label({
		Parent = text, Size = UDim2.new(1, 0, 0, desc and 18 or 28), AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true, Text = name or "",
	})
	local descLabel
	if desc then
		descLabel = Label({
			Parent = text, Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
			Text = desc, TextColor3 = Theme.Muted, TextSize = 11, TextYAlignment = Enum.TextYAlignment.Top,
		})
	end
	return row, nameLabel, descLabel
end

local function VBox(parent, gap)
	return New("Frame", {
		Parent = parent, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, { List(gap or 6) })
end

-- Loading card ----------------------------------------------------------

function Library:Loading(opts)
	opts = opts or {}
	local gui = NewScreenGui("OuroborosLoading", 200)

	local card = New("Frame", {
		Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(400, 200), BackgroundColor3 = Theme.Backdrop, ClipsDescendants = true,
	}, { Corner(14), Stroke(Theme.Stroke, 0.3) })
	New("UIScale", { Parent = card, Scale = math.clamp((ViewSize().X - 24) / 400, 0.5, 1) })

	New("Frame", { Parent = card, Position = UDim2.fromOffset(22, 20), Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Theme.Element }, { Corner(22) })
	Acc(Label({ Parent = card, Position = UDim2.fromOffset(22, 20), Size = UDim2.fromOffset(44, 44), Text = "◉",
		TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center }), "TextColor3")

	Label({ Parent = card, Position = UDim2.fromOffset(78, 22), Size = UDim2.fromOffset(200, 20),
		Text = opts.Name or "Ouroboros", Font = Theme.FontBold, TextSize = 16 })
	Label({ Parent = card, Position = UDim2.fromOffset(78, 42), Size = UDim2.fromOffset(200, 16),
		Text = opts.Version or "v0.1", TextColor3 = Theme.Muted, TextSize = 12 })

	local percent = Label({ Parent = card, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 30),
		Size = UDim2.fromOffset(60, 18), Text = "0%", TextColor3 = Theme.Muted, TextXAlignment = Enum.TextXAlignment.Right })

	New("Frame", { Parent = card, Position = UDim2.fromOffset(22, 76), Size = UDim2.new(1, -44, 0, 1),
		BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0 })

	local steps = New("Frame", { Parent = card, Position = UDim2.fromOffset(22, 90), Size = UDim2.new(1, -44, 0, 90),
		BackgroundTransparency = 1 }, { List(8) })

	local barBack = New("Frame", { Parent = card, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 3), BackgroundTransparency = 1 })
	local bar = Acc(New("Frame", { Parent = barBack, Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }), "BackgroundColor3")

	local loader = { _rows = {}, _progress = 0 }

	local function setProgress(p)
		loader._progress = math.clamp(p, 0, 1)
		percent.Text = math.floor(loader._progress * 100) .. "%"
		Tween(bar, { Size = UDim2.new(loader._progress, 0, 1, 0) }, 0.35)
	end

	local function finishRow(r)
		if not r then
			return
		end
		r.spin:Destroy()
		r.mark.Text = "✓"
		r.text.TextColor3 = Theme.Muted
	end

	function loader:Step(text, progress)
		finishRow(self._rows[#self._rows])
		local row = New("Frame", { Parent = steps, Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1 })
		local mark = Acc(Label({ Parent = row, Size = UDim2.fromOffset(20, 20), Text = "", TextSize = 14 }), "TextColor3")
		local spin = Acc(Label({ Parent = row, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(20, 20), Text = "◜", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center }), "TextColor3")
		local t = Label({ Parent = row, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -30, 1, 0), Text = text })
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			if not spin.Parent then
				conn:Disconnect()
				return
			end
			spin.Rotation = (spin.Rotation + dt * 360) % 360
		end)
		table.insert(self._rows, { mark = mark, spin = spin, text = t })
		setProgress(progress or (#self._rows / (opts.Steps or 4)))
		task.wait(opts.StepDelay or 0.25)
	end

	function loader:SetProgress(p)
		setProgress(p)
	end

	function loader:Finish()
		finishRow(self._rows[#self._rows])
		setProgress(1)
		task.wait(0.35)
		Tween(card, { BackgroundTransparency = 1, Size = UDim2.fromOffset(400, 0) }, 0.3)
		task.wait(0.3)
		gui:Destroy()
	end

	return loader
end

