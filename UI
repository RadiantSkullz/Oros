			-- toggle ------------------------------------------------------
			function card:AddToggle(o2)
				local state = o2.Default == true
				local row = MakeRow(self.Body, o2.Name, o2.Desc, 50)
				local track = New("TextButton", { Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(42, 22), Text = "", AutoButtonColor = false,
					BackgroundColor3 = state and Theme.Accent or Theme.Track }, { Corner(11) })
				local function knobPos(on, w)
					return on and UDim2.new(1, -(w + 3), 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
				end
				local knob = New("Frame", { Parent = track, AnchorPoint = Vector2.new(0, 0.5), Position = knobPos(state, 16),
					Size = UDim2.fromOffset(16, 16), BackgroundColor3 = state and Theme.Knob or Theme.Muted }, { Corner(8) })
				OnAccent(function(c2)
					if state then
						track.BackgroundColor3 = c2
					end
				end)
				local obj = {}
				local squeezed = false
				local function set(v, silent)
					state = v and true or false
					squeezed = false
					Tween(track, { BackgroundColor3 = state and Theme.Accent or Theme.Track }, 0.2)
					Tween(knob, { Position = knobPos(state, 16), Size = UDim2.fromOffset(16, 16),
						BackgroundColor3 = state and Theme.Knob or Theme.Muted }, 0.2)
					if not silent and o2.Callback then
						task.spawn(o2.Callback, state)
					end
				end
				track.MouseButton1Down:Connect(function()
					squeezed = true
					Tween(knob, { Size = UDim2.fromOffset(21, 16), Position = knobPos(state, 21) }, 0.1)
				end)
				track.MouseLeave:Connect(function()
					if squeezed then
						squeezed = false
						Tween(knob, { Size = UDim2.fromOffset(16, 16), Position = knobPos(state, 16) }, 0.15)
					end
				end)
				track.MouseButton1Click:Connect(function()
					set(not state)
				end)
				function obj:Set(v) set(v) end
				function obj:Get() return state end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, row, o2.Desc)
				if o2.Default and o2.FireOnLoad then
					task.spawn(o2.Callback or function() end, state)
				end
				return obj
			end

			-- slider ------------------------------------------------------
			function card:AddSlider(o2)
				local min, max, dec = o2.Min or 0, o2.Max or 100, o2.Decimals or 0
				local value = math.clamp(o2.Default or min, min, max)
				local wrap = VBox(self.Body, 4)
				local top = MakeRow(wrap, o2.Name, o2.Desc, 70)
				local box = New("TextBox", { Parent = top, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0, 14),
					Size = UDim2.fromOffset(60, 26), BackgroundColor3 = Theme.Element, Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.Text, Text = "", ClearTextOnFocus = false }, { Corner(6), Stroke(Theme.Stroke, 0.5) })
				local hit = New("Frame", { Parent = wrap, Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1 })
				local back = New("Frame", { Parent = hit, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = Theme.Track }, { Corner(3) })
				local fill = Acc(New("Frame", { Parent = back, Size = UDim2.fromScale(0, 1) }, { Corner(3) }), "BackgroundColor3")
				local thumb = Acc(New("Frame", { Parent = fill, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(12, 12) }, { Corner(8) }), "BackgroundColor3")
				local suffix = o2.Suffix or ""
				local obj = {}
				local function set(v, silent)
					if o2.Step then
						v = min + math.floor((v - min) / o2.Step + 0.5) * o2.Step
					end
					v = math.clamp(Round(v, dec), min, max)
					value = v
					box.Text = tostring(v) .. suffix
					fill.Size = UDim2.new((max == min) and 0 or (v - min) / (max - min), 0, 1, 0)
					if not silent and o2.Callback then
						task.spawn(o2.Callback, v)
					end
				end
				local function fromX(x)
					local rel = math.clamp((x - back.AbsolutePosition.X) / math.max(back.AbsoluteSize.X, 1), 0, 1)
					set(min + (max - min) * rel)
				end
				TrackDrag(hit, keep, function(input)
					page.ScrollingEnabled = false
					Tween(thumb, { Size = UDim2.fromOffset(16, 16) }, 0.12)
					fromX(input.Position.X)
				end, function(pos)
					fromX(pos.X)
				end, function()
					page.ScrollingEnabled = true
					Tween(thumb, { Size = UDim2.fromOffset(12, 12) }, 0.12)
				end)
				box.FocusLost:Connect(function()
					local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
					set(n or value)
				end)
				set(value, true)
				function obj:Set(v) set(v) end
				function obj:Get() return value end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, wrap, o2.Desc)
				return obj
			end

			-- dropdown (single or multi) -----------------------------------
			function card:AddDropdown(o2)
				local multi = o2.Multi == true
				local options = o2.Options or {}
				local selected = {}
				local single = o2.Default
				if multi then
					for _, v in ipairs(o2.Default or {}) do
						selected[v] = true
					end
				elseif single == nil then
					single = options[1]
				end

				local wrap = VBox(self.Body, 6)
				local top = MakeRow(wrap, o2.Name, o2.Desc, 150)
				local btn2 = New("TextButton", { Parent = top, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0, 14),
					Size = UDim2.fromOffset(140, 30), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false },
					{ Corner(7), Stroke(Theme.Stroke, 0.5) })
				local txt = Label({ Parent = btn2, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0), TextSize = 12,
					TextTruncate = Enum.TextTruncate.AtEnd, Text = "" })
				local arrow = MakeIcon({ Parent = btn2, Name = "chevron-down", Size = 14, AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(1, -14, 0.5, 0), Color = Theme.Muted })
				btn2.MouseEnter:Connect(function()
					Tween(btn2, { BackgroundColor3 = Theme.ElementHover }, 0.12)
				end)
				btn2.MouseLeave:Connect(function()
					Tween(btn2, { BackgroundColor3 = Theme.Element }, 0.12)
				end)

				local listWrap = New("Frame", { Parent = wrap, Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
					ClipsDescendants = true, Visible = false })
				local list = New("ScrollingFrame", { Parent = listWrap, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.CardHeader,
					ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Stroke, CanvasSize = UDim2.new(),
					AutomaticCanvasSize = Enum.AutomaticSize.Y }, { Corner(8), Stroke(Theme.Stroke, 0.3), List(2), Pad(4, 4) })
				local items = {}
				local obj = {}
				local open = false

				local function setOpen(v)
					open = v
					if v then
						listWrap.Visible = true
						Tween(listWrap, { Size = UDim2.new(1, 0, 0, math.min(#options, 6) * 30 + 8) }, 0.2)
					else
						local tw = Tween(listWrap, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
						tw.Completed:Connect(function()
							if not open then
								listWrap.Visible = false
							end
						end)
					end
					Tween(arrow.Frame, { Rotation = v and 180 or 0 }, 0.15)
				end

				local function getMulti()
					local out = {}
					for _, o in ipairs(options) do
						if selected[o] then
							table.insert(out, o)
						end
					end
					return out
				end
				local function refresh()
					for opt, it in pairs(items) do
						local on = multi and selected[opt] or (not multi and single == opt)
						it.mark.Frame.Visible = on and true or false
						it.label.TextColor3 = on and Theme.Accent or Theme.Text
					end
					if multi then
						local m = getMulti()
						txt.Text = #m == 0 and "None" or table.concat(m, ", ")
					else
						txt.Text = single ~= nil and tostring(single) or "None"
					end
				end
				local function fire()
					if o2.Callback then
						task.spawn(o2.Callback, multi and getMulti() or single)
					end
				end
				local function build()
					for _, c2 in ipairs(list:GetChildren()) do
						if c2:IsA("TextButton") then
							c2:Destroy()
						end
					end
					items = {}
					for _, opt in ipairs(options) do
						local b = New("TextButton", { Parent = list, Size = UDim2.new(1, -4, 0, 28), BackgroundColor3 = Theme.Element,
							BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, { Corner(5) })
						local l = Label({ Parent = b, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -30, 1, 0), Text = tostring(opt),
							TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd })
						local mk = MakeIcon({ Parent = b, Name = "check", Size = 13, AnchorPoint = Vector2.new(1, 0.5),
							Position = UDim2.new(1, -8, 0.5, 0), Accent = true })
						mk.Frame.Visible = false
						items[opt] = { label = l, mark = mk }
						b.MouseEnter:Connect(function() Tween(b, { BackgroundTransparency = 0 }, 0.1) end)
						b.MouseLeave:Connect(function() Tween(b, { BackgroundTransparency = 1 }, 0.1) end)
						b.MouseButton1Click:Connect(function()
							if multi then
								selected[opt] = not selected[opt] or nil
							else
								single = opt
								setOpen(false)
							end
							refresh()
							fire()
						end)
					end
					refresh()
				end
				build()
				btn2.MouseButton1Click:Connect(function()
					setOpen(not open)
				end)
				function obj:Get() return multi and getMulti() or single end
				function obj:Set(v)
					if multi then
						selected = {}
						for _, x in ipairs(v or {}) do selected[x] = true end
					else
						single = v
					end
					refresh()
					fire()
				end
				function obj:Refresh(newOptions, keepSelection)
					options = newOptions
					if not keepSelection then
						selected = {}
						single = (not multi) and options[1] or nil
					end
					build()
					if open then
						listWrap.Size = UDim2.new(1, 0, 0, math.min(#options, 6) * 30 + 8)
					end
				end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, wrap, o2.Desc)
				return obj
			end

			-- text input --------------------------------------------------
			function card:AddInput(o2)
				local row = MakeRow(self.Body, o2.Name, o2.Desc, 150)
				local st = Stroke(Theme.Stroke, 0.5)
				local box = New("TextBox", { Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(140, 30), BackgroundColor3 = Theme.Element, Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.Text, PlaceholderText = o2.Placeholder or "Type here...", PlaceholderColor3 = Theme.Muted,
					Text = tostring(o2.Default or ""), ClearTextOnFocus = false, TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left }, { Corner(7), st, Pad(10, 0) })
				box.Focused:Connect(function()
					Tween(st, { Color = Theme.Accent, Transparency = 0.2 }, 0.15)
				end)
				local obj = {}
				local function out()
					if o2.Numeric then
						return tonumber(box.Text)
					end
					return box.Text
				end
				if o2.Numeric then
					box:GetPropertyChangedSignal("Text"):Connect(function()
						local clean = box.Text:gsub("[^%d%.%-]", "")
						if clean ~= box.Text then
							box.Text = clean
						end
					end)
				end
				box.FocusLost:Connect(function(enter)
					Tween(st, { Color = Theme.Stroke, Transparency = 0.5 }, 0.15)
					if o2.Callback and (enter or not o2.EnterOnly) then
						task.spawn(o2.Callback, out())
					end
				end)
				function obj:Get() return out() end
				function obj:Set(v)
					box.Text = tostring(v or "")
					if o2.Callback then
						task.spawn(o2.Callback, out())
					end
				end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, row, o2.Desc)
				return obj
			end

			-- keybind -----------------------------------------------------
			function card:AddKeybind(o2)
				local key = o2.Default or Enum.KeyCode.Unknown
				local listening = false
				local row = MakeRow(self.Body, o2.Name, o2.Desc, 96)
				local btn2 = New("TextButton", { Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(86, 28), BackgroundColor3 = Theme.Element, Font = Theme.FontBold, TextSize = 11,
					TextColor3 = Theme.Text, Text = "", AutoButtonColor = false }, { Corner(7), Stroke(Theme.Stroke, 0.5) })
				local function paint()
					btn2.Text = listening and "..." or (key == Enum.KeyCode.Unknown and "None" or key.Name)
					btn2.TextColor3 = listening and Theme.Accent or Theme.Text
				end
				paint()
				btn2.MouseButton1Click:Connect(function()
					listening = true
					paint()
				end)
				local obj = {}
				keep(UserInputService.InputBegan:Connect(function(input, gp)
					if listening then
						if input.UserInputType == Enum.UserInputType.Keyboard then
							listening = false
							key = input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode
							paint()
							if o2.ChangedCallback then
								task.spawn(o2.ChangedCallback, key)
							end
						end
						return
					end
					if not gp and key ~= Enum.KeyCode.Unknown and input.KeyCode == key and o2.Callback then
						task.spawn(o2.Callback, key)
					end
				end))
				function obj:Get() return key end
				function obj:Set(k)
					key = k or Enum.KeyCode.Unknown
					paint()
					if o2.ChangedCallback then
						task.spawn(o2.ChangedCallback, key)
					end
				end
				function obj:IsDown() return key ~= Enum.KeyCode.Unknown and UserInputService:IsKeyDown(key) end
				flag(o2, obj.Get, obj.Set)
				register(o2.Name, row, o2.Desc)
				return obj
			end

