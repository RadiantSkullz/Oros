		function tab:AddStats()
			local frame, body = RawCard(208)
			local function stat(x, title, iconName)
				MakeIcon({ Parent = body, Name = iconName, Size = 12, Position = UDim2.new(x, 0, 0, 1), Color = Theme.Muted })
				Label({ Parent = body, Position = UDim2.new(x, 17, 0, 0), Size = UDim2.fromOffset(120, 14), Text = title,
					TextColor3 = Theme.Muted, TextSize = 10 })
				return Label({ Parent = body, Position = UDim2.new(x, 0, 0, 18), Size = UDim2.fromOffset(160, 36), Text = "--",
					TextSize = 26 })
			end
			local fpsLabel = stat(0, "FPS", "gauge")
			local pingLabel = stat(0.5, "PING", "wifi")
			local graph = New("Frame", { Parent = body, Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 40),
				BackgroundTransparency = 1 }, { List(2, Enum.FillDirection.Horizontal) })
			graph:FindFirstChildOfClass("UIListLayout").VerticalAlignment = Enum.VerticalAlignment.Bottom
			local bars = {}
			for i = 1, 60 do
				bars[i] = New("Frame", { Parent = graph, Size = UDim2.new(1 / 60, -2, 0, 3), BackgroundColor3 = Theme.Stroke,
					LayoutOrder = i }, { Corner(1) })
			end
			local function mini(x, y, title)
				local v2 = Label({ Parent = body, Position = UDim2.new(x, 0, 0, y), Size = UDim2.fromOffset(120, 20), Text = "",
					TextSize = 15 })
				Label({ Parent = body, Position = UDim2.new(x, 0, 0, y + 20), Size = UDim2.fromOffset(120, 14), Text = title,
					TextColor3 = Theme.Muted, TextSize = 10 })
				return v2
			end
			local playersLabel = mini(0, 134, "PLAYERS")
			local sessionLabel = mini(0.5, 134, "SESSION")
			local started = os.clock()
			local history = {}
			task.spawn(function()
				while gui.Parent do
					local ping = 0
					pcall(function()
						ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
					end)
					fpsLabel.Text = tostring(fps)
					fpsLabel.TextColor3 = fps >= 50 and Theme.Text or (fps >= 30 and Theme.Warn or Theme.Good)
					pingLabel.Text = ping .. "ms"
					pingLabel.TextColor3 = ping < 100 and Theme.Text or (ping < 200 and Theme.Warn or Theme.Good)
					playersLabel.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
					local sec = math.floor(os.clock() - started)
					sessionLabel.Text = sec >= 3600 and string.format("%dh %dm", sec // 3600, (sec % 3600) // 60)
						or (sec >= 60 and string.format("%dm %ds", sec // 60, sec % 60) or sec .. "s")
					table.insert(history, fps)
					if #history > 60 then
						table.remove(history, 1)
					end
					for i = 1, 60 do
						local val = history[#history - 60 + i]
						if val then
							bars[i].Size = UDim2.new(1 / 60, -2, 0, math.clamp(val / 60, 0.08, 1) * 40)
							bars[i].BackgroundColor3 = val >= 50 and Theme.Accent or (val >= 30 and Theme.Warn or Theme.Good)
						end
					end
					task.wait(1)
				end
			end)
			return frame
		end

		function tab:AddGameCard()
			local frame, body = RawCard(190)
			local icon = New("ImageLabel", { Parent = body, Size = UDim2.fromOffset(54, 54), BackgroundColor3 = Theme.Element,
				Image = "" }, { Corner(12) })
			local title = Label({ Parent = body, Position = UDim2.fromOffset(68, 6), Size = UDim2.new(1, -70, 0, 20), Text = "...",
				TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd })
			local sub = Label({ Parent = body, Position = UDim2.fromOffset(68, 28), Size = UDim2.new(1, -70, 0, 16), Text = "",
				TextColor3 = Theme.Muted, TextSize = 11 })
			task.spawn(function()
				local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, game.PlaceId)
				if ok then
					title.Text = info.Name
					sub.Text = ("by %s  ·  %d/%d players"):format(info.Creator.Name, #Players:GetPlayers(), Players.MaxPlayers)
					if info.IconImageAssetId and info.IconImageAssetId ~= 0 then
						icon.Image = "rbxassetid://" .. info.IconImageAssetId
					end
				end
			end)
			local function serverList()
				local ok, res = pcall(function()
					return HttpService:JSONDecode(game:HttpGet(
						("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)))
				end)
				return ok and res.data or {}
			end
			local row = New("Frame", { Parent = body, Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 62),
				BackgroundTransparency = 1 }, { List(8, Enum.FillDirection.Horizontal) })
			local function act(text, iconName, cb)
				local b = New("TextButton", { Parent = row, Size = UDim2.new(0.25, -6, 1, 0), Text = "", AutoButtonColor = false,
					BackgroundColor3 = Theme.Element }, { Corner(10) })
				local ic = MakeIcon({ Parent = b, Name = iconName, Size = 18, AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, 0, 0, 10), Color = Theme.Muted })
				local lb = Label({ Parent = b, Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 0, 16), Text = text, TextSize = 11,
					TextColor3 = Theme.Muted, TextXAlignment = Enum.TextXAlignment.Center })
				b.MouseEnter:Connect(function()
					Tween(b, { BackgroundColor3 = Theme.ElementHover }, 0.15)
					ic:TweenColor(Theme.Text, 0.15)
					Tween(lb, { TextColor3 = Theme.Text }, 0.15)
				end)
				b.MouseLeave:Connect(function()
					Tween(b, { BackgroundColor3 = Theme.Element }, 0.15)
					ic:TweenColor(Theme.Muted, 0.15)
					Tween(lb, { TextColor3 = Theme.Muted }, 0.15)
				end)
				b.MouseButton1Click:Connect(function() task.spawn(cb) end)
			end
			act("Rejoin", "refresh-cw", function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
			end)
			act("Hop", "shuffle", function()
				for _, sv in ipairs(serverList()) do
					if sv.id ~= game.JobId and sv.playing < sv.maxPlayers then
						TeleportService:TeleportToPlaceInstance(game.PlaceId, sv.id, LocalPlayer)
						return
					end
				end
				Window:Notify({ Title = "Server hop", Content = "No other server found.", Type = "warning" })
			end)
			act("Lowest", "users", function()
				local best
				for _, sv in ipairs(serverList()) do
					if sv.id ~= game.JobId and (not best or sv.playing < best.playing) then
						best = sv
					end
				end
				if best then
					TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, LocalPlayer)
				else
					Window:Notify({ Title = "Lowest server", Content = "No other server found.", Type = "warning" })
				end
			end)
			act("Job ID", "copy", function()
				if setclipboard then
					setclipboard(game.JobId)
					Window:Notify({ Title = "Copied", Content = "Job ID copied to clipboard.", Type = "success", Duration = 2.5 })
				end
			end)
			Label({ Parent = body, Position = UDim2.fromOffset(0, 140), Size = UDim2.new(1, 0, 0, 14),
				Text = ("Job %s  ·  Place %d"):format(game.JobId:sub(1, 8) .. "..." .. game.JobId:sub(-4), game.PlaceId),
				TextColor3 = Theme.Muted, TextSize = 10 })
			return frame
		end

