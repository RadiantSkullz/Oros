		ui:AddKeybind({ Name = "Toggle Keybind", Desc = "PC only. Tap the island on mobile.", Default = self.Keybind,
			Flag = "_ui_keybind", ChangedCallback = function(k)
				if k ~= Enum.KeyCode.Unknown then
					self.Keybind = k
				end
			end })
		ui:AddColorPicker({ Name = "Accent Color", Default = Theme.Accent, Flag = "_ui_accent", Callback = function(c)
			self:SetAccent(c)
		end })
		ui:AddSlider({ Name = "UI Scale", Min = 0.6, Max = 1.4, Step = 0.05, Decimals = 2, Default = self._userScale,
			Flag = "_ui_scale", Callback = function(v)
				self:SetScale(v)
			end })
		ui:AddSlider({ Name = "Background Dim", Min = 0, Max = 0.9, Step = 0.05, Decimals = 2, Default = self._dim,
			Flag = "_ui_dim", Callback = function(v)
				self:SetDim(v)
			end })
		ui:AddToggle({ Name = "Bokeh Particles", Default = self._bokeh, Flag = "_ui_bokeh", Callback = function(v)
			self:SetBokeh(v)
		end })
		ui:AddSlider({ Name = "Bokeh Density", Min = 8, Max = 70, Step = 2, Default = self._particles, Flag = "_ui_particles",
			Callback = function(v)
				self:SetParticles(v)
			end })

		local cfg = tab:AddCard({ Title = "Configs", Icon = "save", Side = "Right" })
		local nameInput = cfg:AddInput({ Name = "Config Name", Placeholder = "default", Default = "default" })
		local dd = cfg:AddDropdown({ Name = "Saved Configs", Options = self:ListConfigs() })
		local function refresh()
			dd:Refresh(self:ListConfigs())
		end
		cfg:AddButton({ Name = "Save Config", Callback = function()
			local n = nameInput:Get()
			if n == "" then
				n = "default"
			end
			local ok, err = self:SaveConfig(n)
			self:Notify({ Title = ok and "Config saved" or "Save failed", Content = ok and n or tostring(err),
				Type = ok and "success" or "error" })
			refresh()
		end })
		cfg:AddButton({ Name = "Load Selected", Callback = function()
			local n = dd:Get()
			if not n then
				return self:Notify({ Title = "Pick a config first", Type = "warning" })
			end
			local ok, err = self:LoadConfig(n)
			self:Notify({ Title = ok and "Config loaded" or "Load failed", Content = ok and n or tostring(err),
				Type = ok and "success" or "error" })
		end })
		cfg:AddButton({ Name = "Delete Selected", Callback = function()
			local n = dd:Get()
			if n then
				self:DeleteConfig(n)
				refresh()
			end
		end })
		cfg:AddButton({ Name = "Refresh List", Callback = refresh })

		local danger = tab:AddCard({ Title = "Danger Zone", Icon = "triangle-alert", Side = "Right", Open = false })
		danger:AddButton({ Name = "Unload UI", Callback = function()
			self:Destroy()
		end })
		return tab
	end

	Window:SetVisible(true, true)
	return Window
