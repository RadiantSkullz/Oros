local LUCIDE_URL = "https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"
local Lucide = nil
do
	local ok, res = pcall(function()
		return loadstring(game:HttpGet(LUCIDE_URL))()
	end)
	if ok and type(res) == "table" and type(res.GetAsset) == "function" then
		Lucide = res
	end
end
Library.HasIcons = Lucide ~= nil

local assetCache = {}
local function GetIconAsset(name)
	if not Lucide or type(name) ~= "string" then
		return nil
	end
	local cached = assetCache[name]
	if cached ~= nil then
		return cached or nil
	end
	local ok, asset = pcall(Lucide.GetAsset, name)
	assetCache[name] = (ok and asset) or false
	return (ok and asset) or nil
end

