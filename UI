		local v = ViewSize()
		local fit = math.min(1, (v.X - 24) / baseW, (v.Y - 24) / baseH)
		local s = math.max(0.45, fit)
		uiScale.Scale = s * Window._userScale
		notifScale.Scale = math.max(0.6, s)
	end
	applyScale()
	do
		local cam = workspace.CurrentCamera
		if cam then
			keep(cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale))
		end
	end
	function Window:SetScale(n)
		self._userScale = math.clamp(n, 0.5, 1.5)
		applyScale()
	end

	local sidebar = New("Frame", { Parent = main, Size = UDim2.new(0, 190, 1, 0), BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0 })
	New("Frame", { Parent = sidebar, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.4, BorderSizePixel = 0 })

