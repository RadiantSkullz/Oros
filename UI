-- Loading card ----------------------------------------------------------

function Library:Loading(opts)
	opts = opts or {}
	local gui = NewScreenGui("OutscaleLoading", 200)

	local card = New("Frame", {
		Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(400, 200), BackgroundColor3 = Theme.Backdrop, ClipsDescendants = true,
	}, { Corner(14), Stroke(Theme.Stroke, 0.3) })
	New("UIScale", { Parent = card, Scale = math.clamp((ViewSize().X - 24) / 400, 0.5, 1) })

	MakeLogo(card, 44, { Position = UDim2.fromOffset(22, 20), Background = Theme.Element })

	Label({ Parent = card, Position = UDim2.fromOffset(78, 22), Size = UDim2.fromOffset(200, 20),
		Text = opts.Name or "Outscale", Font = Theme.FontBold, TextSize = 16 })
	Label({ Parent = card, Position = UDim2.fromOffset(78, 42), Size = UDim2.fromOffset(200, 16),
		Text = opts.Version or "v0.1", TextColor3 = Theme.Muted, TextSize = 12 })

	local percent = Label({ Parent = card, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 30),
		Size = UDim2.fromOffset(60, 18), Text = "0%", TextColor3 = Theme.Muted, TextXAlignment = Enum.TextXAlignment.Right })

	New("Frame", { Parent = card, Position = UDim2.fromOffset(22, 76), Size = UDim2.new(1, -44, 0, 1),
		BackgroundColor3 = Theme.Stroke })

	local steps = New("Frame", { Parent = card, Position = UDim2.fromOffset(22, 90), Size = UDim2.new(1, -44, 0, 90),
		BackgroundTransparency = 1 }, { List(8) })

	local barBack = New("Frame", { Parent = card, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 3), BackgroundTransparency = 1 })
	local bar = Acc(New("Frame", { Parent = barBack, Size = UDim2.new(0, 0, 1, 0) }), "BackgroundColor3")

	local loader = { _rows = {}, _progress = 0 }

	local function setProgress(p)
		loader._progress = math.clamp(p, 0, 1)
		percent.Text = math.floor(loader._progress * 100) .. "%"
		Tween(bar, { Size = UDim2.new(loader._progress, 0, 1, 0) }, 0.35)
	end

	local function finishRow(r)
		if not r then
			return
		end
		r.spin.Frame:Destroy()
		r.mark.Frame.Visible = true
		r.text.TextColor3 = Theme.Muted
	end

	function loader:Step(text, progress)
		finishRow(self._rows[#self._rows])
		local row = New("Frame", { Parent = steps, Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1 })
		local mark = MakeIcon({ Parent = row, Name = "check", Size = 14, Position = UDim2.fromOffset(0, 3), Accent = true })
		mark.Frame.Visible = false
		local spin = MakeIcon({ Parent = row, Name = "loader-circle", Size = 14, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(7, 10), Accent = true })
		local t = Label({ Parent = row, Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -26, 1, 0), Text = text })
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			if not spin.Frame.Parent then
				conn:Disconnect()
				return
			end
			spin.Frame.Rotation = (spin.Frame.Rotation + dt * 360) % 360
		end)
		table.insert(self._rows, { mark = mark, spin = spin, text = t })
		setProgress(progress or (#self._rows / (opts.Steps or 4)))
		task.wait(opts.StepDelay or 0.25)
	end

	function loader:SetProgress(p)
		setProgress(p)
	end

	function loader:Finish()
		finishRow(self._rows[#self._rows])
		setProgress(1)
		task.wait(0.35)
		Tween(card, { BackgroundTransparency = 1, Size = UDim2.fromOffset(400, 0) }, 0.3)
		task.wait(0.3)
		gui:Destroy()
	end

	return loader
end

-- Window ----------------------------------------------------------------

function Library:CreateWindow(opts)
	opts = opts or {}
	local Window = {
		Tabs = {}, Flags = {}, Visible = true, Keybind = opts.Keybind or Enum.KeyCode.RightShift,
		ConfigFolder = opts.ConfigFolder or "OutscaleUI", OnToggle = opts.OnToggle,
		_elements = {}, _conns = {}, _userScale = opts.Scale or 1, _dim = opts.Dim or 0.55, _bokeh = opts.Bokeh ~= false,
		_particles = opts.Particles or (IS_MOBILE and 16 or 34),
	}
	local name = opts.Name or "Outscale"
	local version = opts.Version or "v0.1"
	local baseW, baseH = 680, 440
	if opts.Size then
		baseW, baseH = opts.Size.X.Offset, opts.Size.Y.Offset
	end

	local function keep(c)
		table.insert(Window._conns, c)
		return c
	end

	local gui = NewScreenGui("OutscaleUI", 100)
	Window.Gui = gui

	-- dim --------------------------------------------------------------
	local dim = New("Frame", { Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1, ZIndex = 0, Active = false })

	-- bokeh ------------------------------------------------------------
	-- three depth layers (far / mid / near). Soft discs are stacked translucent circles (fake blur), some orbs are
	-- hollow lens rings. Orbs sway, twinkle, fade at the edges and shift slightly with the mouse (parallax).
	local bokehLayer = New("Frame", { Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		ClipsDescendants = true, ZIndex = 1, Visible = Window._bokeh })

	local LAYERS = {
		{ share = 0.48, size = { 0.018, 0.04 }, speed = { 0.004, 0.010 }, strength = 0.75, parallax = 6, ring = 0.2 },
		{ share = 0.34, size = { 0.04, 0.085 }, speed = { 0.008, 0.018 }, strength = 1.0, parallax = 14, ring = 0.4 },
		{ share = 0.18, size = { 0.095, 0.18 }, speed = { 0.014, 0.030 }, strength = 0.85, parallax = 30, ring = 0.55 },
	}
	local rng = Random.new()
	local orbs = {}
	local palette = {}
	local function refreshPalette(a)
		palette = {
			a,
			a:Lerp(Color3.new(1, 1, 1), 0.55),
			Color3.fromRGB(255, 236, 240),
			a:Lerp(Color3.fromRGB(255, 176, 120), 0.55),
		}
	end
	OnAccent(function(a)
		refreshPalette(a)
		for _, o in ipairs(orbs) do
			for _, l in ipairs(o.layers) do
				if l.kind == "stroke" then
					l.obj.Color = palette[o.ci]
				else
					l.obj.BackgroundColor3 = palette[o.ci]
				end
			end
		end
	end)

	local function buildBokeh()
		for _, o in ipairs(orbs) do
			o.root:Destroy()
		end
		table.clear(orbs)
		local view = ViewSize()
		for li, L in ipairs(LAYERS) do
			local count = math.max(1, math.floor(Window._particles * L.share + 0.5))
			for _ = 1, count do
				local px = math.max(8, rng:NextNumber(L.size[1], L.size[2]) * view.Y)
				local ci = rng:NextInteger(1, #palette)
				local col = palette[ci]
				local root = New("Frame", {
					Parent = bokehLayer, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(px, px),
					BackgroundTransparency = 1, ZIndex = li,
				})
				local layers = {}
				if rng:NextNumber() < L.ring then
					local body = New("Frame", { Parent = root, Size = UDim2.fromScale(1, 1), BackgroundColor3 = col,
						BackgroundTransparency = 0.94 }, { Corner(px) })
					local st = Stroke(col, 0.6, math.max(1, math.floor(px * 0.03)))
					st.Parent = body
					table.insert(layers, { obj = body, kind = "bg", base = 0.94 })
					table.insert(layers, { obj = st, kind = "stroke", base = 0.6 })
				else
					for _, spec in ipairs({ { 1, 0.93 }, { 0.7, 0.88 }, { 0.4, 0.82 } }) do
						local d = px * spec[1]
						local f = New("Frame", {
							Parent = root, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
							Size = UDim2.fromOffset(d, d), BackgroundColor3 = col, BackgroundTransparency = spec[2],
						}, { Corner(d) })
						table.insert(layers, { obj = f, kind = "bg", base = spec[2] })
					end
				end
				table.insert(orbs, {
					root = root, layers = layers, layer = L, ci = ci,
					x = rng:NextNumber(), y = rng:NextNumber(),
					speed = rng:NextNumber(L.speed[1], L.speed[2]),
					swayA = rng:NextNumber(0.006, 0.02), swayF = rng:NextNumber(0.2, 0.55), phase = rng:NextNumber(0, 6.28),
					twF = rng:NextNumber(0.4, 1.1), twP = rng:NextNumber(0, 6.28),
				})
			end
		end
	end
	buildBokeh()

	local clock, alphaTimer = 0, 0
	local parX, parY = 0, 0
	keep(RunService.RenderStepped:Connect(function(dt)
		if not Window.Visible or not Window._bokeh then
			return
		end
		clock += dt
		alphaTimer += dt
		local updateAlpha = alphaTimer >= 0.04
		if updateAlpha then
			alphaTimer = 0
		end
		if not IS_MOBILE then
			local view = ViewSize()
			local m = UserInputService:GetMouseLocation()
			local k = math.min(1, dt * 3)
			parX += ((m.X / view.X - 0.5) - parX) * k
			parY += ((m.Y / view.Y - 0.5) - parY) * k
		end
		for _, o in ipairs(orbs) do
			o.y -= o.speed * dt
			if o.y < -0.12 then
				o.y = 1.12
				o.x = rng:NextNumber()
			end
			local L = o.layer
			local sway = math.sin(clock * o.swayF + o.phase) * o.swayA
			o.root.Position = UDim2.new(o.x + sway, -parX * L.parallax, o.y, -parY * L.parallax)
			if updateAlpha then
				local fade = math.clamp(math.min(o.y, 1 - o.y) / 0.14, 0, 1)
				local tw = 0.78 + 0.22 * math.sin(clock * o.twF + o.twP)
				local k2 = fade * tw * L.strength
				for _, l in ipairs(o.layers) do
					local v = 1 - (1 - l.base) * k2
					if l.kind == "stroke" then
						l.obj.Transparency = v
					else
						l.obj.BackgroundTransparency = v
					end
				end
			end
		end
	end))

